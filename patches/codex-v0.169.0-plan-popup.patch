+async fn plan_implementation_popup_closes_when_a_remote_client_starts_a_new_turn() {
+    let (mut chat, _rx, _op_rx) = make_chatwidget_manual(Some("gpt-5")).await;
+    handle_turn_started(&mut chat, "planning");
+    handle_turn_completed(&mut chat, "planning", /*duration_ms*/ None);
+    chat.open_plan_implementation_prompt();
+    assert!(render_bottom_popup(&chat, 80).contains(PLAN_IMPLEMENTATION_TITLE));
+
+    handle_turn_started(&mut chat, "planning");
+    assert!(render_bottom_popup(&chat, 80).contains(PLAN_IMPLEMENTATION_TITLE));
+
+    handle_turn_started(&mut chat, "implementing");
+    assert!(!render_bottom_popup(&chat, 80).contains(PLAN_IMPLEMENTATION_TITLE));
+}
